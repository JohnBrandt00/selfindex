{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CodeIndexer.Services.IndexingOrchestrator": "Debug",
      "CodeIndexer.Services.DocumentCracker": "Debug",
      "CodeIndexer.Services.VisionService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "embeddinggemma",
    "VisionModel": "gemma4:e2b",
    "ChatModel": "gemma4:e2b"
  },
  "Lucene": {
    "IndexPath": "lucene-index"
  },
  "Enrichers": {
    "Md5": true,
    "LastModified": true,
    "FileSize": true,
    "Language": true
  },
  "Indexer": {
    "Extensions": ".cs,.ts,.tsx,.js,.jsx,.py,.go,.rs,.java,.kt,.cpp,.c,.h,.hpp,.md,.txt,.json,.yaml,.yml,.xml,.sql,.toml,.sh,.ps1,.bat,.razor,.html,.htm,.css,.scss,.rb,.php,.swift,.fs,.fsx,.vue,.svelte,.pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.gif,.bmp,.webp",
    "ExcludeFolders": "obj,bin,node_modules,.git,.svn,dist,build,__pycache__,.next,.nuget,packages",
    "ExcludeFiles": "package-lock.json,yarn.lock,pnpm-lock.yaml"
  }
}
