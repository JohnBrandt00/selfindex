{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "embeddinggemma"
  },
  "Lucene": {
    "IndexPath": "lucene-index"
  },
  "Indexer": {
    "Extensions": ".cs,.ts,.tsx,.js,.jsx,.py,.go,.rs,.java,.kt,.cpp,.c,.h,.hpp,.md,.txt,.json,.yaml,.yml,.xml,.sql,.toml,.sh,.ps1,.bat,.razor,.html,.css,.scss,.rb,.php,.swift,.fs,.fsx,.vue,.svelte",
    "ExcludeFolders": "obj,bin,node_modules,.git,.svn,dist,build,__pycache__,.next,.nuget,packages"
  }
}
