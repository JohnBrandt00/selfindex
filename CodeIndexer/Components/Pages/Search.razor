@page "/search"
@using CodeIndexer.Models
@using CodeIndexer.Services
@inject LuceneIndexService Lucene
@inject VectorIndexService Vectors
@inject EmbeddingService Embeddings
@inject IndexingState State
@inject IndexingOrchestrator Orchestrator

<h4 class="mb-3">Search Code Index</h4>

<div class="row g-2 mb-2">
  <div class="col">
    <input class="form-control font-monospace"
           @bind="_query"
           @bind:event="oninput"
           @onkeydown="OnKeyDown"
           placeholder="Ask about the code... (Enter to search)" />
  </div>
  <div class="col-auto">
    <div class="btn-group">
      <button class="btn @ModeBtn("hybrid")"  @onclick='() => _mode = "hybrid"'>Hybrid</button>
      <button class="btn @ModeBtn("vector")"  @onclick='() => _mode = "vector"'>Vector</button>
      <button class="btn @ModeBtn("text")"    @onclick='() => _mode = "text"'>BM25</button>
    </div>
  </div>
  <div class="col-auto">
    <button class="btn btn-success" @onclick="RunSearch" disabled="@_searching">
      @(_searching ? "Searching..." : "Search")
    </button>
  </div>
</div>

<div class="row g-2 mb-2 align-items-center">
  <div class="col-auto d-flex align-items-center gap-2">
    <span class="text-muted small">Exclude:</span>
    <input class="form-control form-control-sm font-monospace" style="width:240px"
           @bind="_exclude" @bind:event="oninput"
           placeholder="test, *.min.js, migrations" />
  </div>
  <div class="col-auto d-flex align-items-center gap-2">
    <span class="text-muted small">Type:</span>
    <select class="form-select form-select-sm" style="width:130px" @bind="_filterType">
      <option value="">All types</option>
      <option value="class">class</option>
      <option value="method">method</option>
      <option value="file">file</option>
      <option value="page">page</option>
      <option value="section">section</option>
      <option value="image">image</option>
      <option value="block">block</option>
    </select>
  </div>
  <div class="col-auto d-flex align-items-center gap-2">
    <span class="text-muted small">Language:</span>
    <select class="form-select form-select-sm" style="width:140px" @bind="_filterLang">
      <option value="">All languages</option>
      @foreach (var lang in _availableLangs)
      {
        <option value="@lang">@lang</option>
      }
    </select>
  </div>
  <div class="col-auto ms-auto d-flex align-items-center gap-3">
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" id="rawToggle" @bind="_rawLucene" />
      <label class="form-check-label small" for="rawToggle">Raw Lucene</label>
    </div>
    <a href="/ai-endpoint" class="text-muted small">MCP →</a>
  </div>
</div>

<div class="text-muted small mb-3 d-flex gap-3 align-items-center flex-wrap">
  <span>Lucene: <strong>@Lucene.DocumentCount</strong></span>
  <span>HNSW: <strong>@Vectors.LiveEntries</strong> live</span>
  <span>@Embeddings.Model @(Embeddings.Dimensions > 0 ? $"({Embeddings.Dimensions}d)" : "")</span>
  <span class="badge @(_mode == "hybrid" ? "bg-primary" : "bg-secondary")">
    @(_mode == "hybrid" ? "RRF hybrid" : _mode == "vector" ? "HNSW cosine" : "BM25 keyword")
  </span>
</div>

@if (_error != null) { <div class="alert alert-danger">@_error</div> }

@if (_results.Count > 0)
{
  <div class="mb-2 text-muted small">@_filtered.Count results (@_results.Count before filters) in @_elapsedMs ms</div>
  @foreach (var r in _filtered)
  {
    <div class="card mb-2 result-card">
      <div class="card-header d-flex justify-content-between align-items-center py-1 flex-wrap gap-1">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <span class="badge @BadgeColor(r.ChunkType)">@r.ChunkType</span>
          @if (!string.IsNullOrEmpty(r.Language))
          {
            <span class="badge bg-dark text-secondary border border-secondary" style="font-size:0.65rem">@r.Language</span>
          }
          <span class="fw-semibold">@r.Symbol</span>
          <span class="text-muted small font-monospace">@r.RelativePath:@r.StartLine</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="small text-muted font-monospace">
            @if (r.BM25Score > 0)   { <span class="me-1">bm25:@r.BM25Score.ToString("F2")</span> }
            @if (r.VectorScore > 0) { <span class="me-1">cos:@r.VectorScore.ToString("F2")</span> }
            @if (r.HybridScore > 0) { <span>rrf:@r.HybridScore.ToString("F4")</span> }
          </div>
          @if (!string.IsNullOrEmpty(r.LastModified))
          {
            <span class="text-muted small" title="@r.LastModified">@FormatDate(r.LastModified)</span>
          }
          @if (!string.IsNullOrEmpty(r.FileSize))
          {
            <span class="text-muted small">@FormatBytes(r.FileSize)</span>
          }
          <button class="btn btn-outline-secondary btn-sm py-0 px-1" style="font-size:0.65rem"
                  title="Re-index this file"
                  @onclick="() => ReindexFile(r.FilePath)">↺</button>
        </div>
      </div>
      <div class="card-body p-0">
        <pre class="code-preview m-0 p-2">@TrimContent(r.Content)</pre>
      </div>
    </div>
  }
}
else if (_searched && !_searching)
{
  <div class="text-muted">No results for "<em>@_query</em>".</div>
}
else if (!State.IsWatching && Lucene.DocumentCount == 0)
{
  <div class="alert alert-info">
    No index yet — go to the <a href="/">Dashboard</a> and point it at a repo.
  </div>
}

@code {
    private string _query      = "";
    private string _exclude    = "";
    private string _filterType = "";
    private string _filterLang = "";
    private string _mode       = "hybrid";
    private bool   _searching, _searched, _rawLucene;
    private string? _error;
    private long _elapsedMs;
    private List<SearchResult> _results  = [];
    private List<SearchResult> _filtered = [];
    private List<string> _availableLangs = [];

    protected override void OnInitialized()
    {
        // Populate language list from recent docs
        _availableLangs = Lucene.GetDistinctLanguages();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunSearch();
    }

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        _searching = true; _error = null; _searched = true;
        StateHasChanged();
        try
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            _results = _mode switch
            {
                "text"   => Lucene.TextSearch(_query, 30, _rawLucene).Select(t => t.result).ToList(),
                "vector" => await RunVectorAsync(),
                _        => await RunHybridAsync()
            };
            _elapsedMs = sw.ElapsedMilliseconds;
            ApplyFilters();
        }
        catch (Exception ex) { _error = ex.Message; _results = []; _filtered = []; }
        finally { _searching = false; }
    }

    private void ApplyFilters()
    {
        _filtered = _results
            .Where(r => string.IsNullOrEmpty(_filterType) || r.ChunkType == _filterType)
            .Where(r => string.IsNullOrEmpty(_filterLang) || r.Language == _filterLang)
            .Where(r => !MatchesExclusion(r))
            .ToList();
    }

    private bool MatchesExclusion(SearchResult r)
    {
        var patterns = _exclude.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return patterns.Any(p => MatchesPattern(r.RelativePath, p));
    }

    private async Task<List<SearchResult>> RunVectorAsync()
    {
        var emb = await Embeddings.EmbedAsync(_query);
        return Lucene.FetchByKeys(Vectors.Search(emb, 20));
    }

    private async Task<List<SearchResult>> RunHybridAsync()
    {
        const int k = 60;
        var emb        = await Embeddings.EmbedAsync(_query);
        var textHits   = Lucene.TextSearch(_query, 60, _rawLucene);
        var vectorHits = Vectors.Search(emb, 60);

        if (_rawLucene && !string.IsNullOrWhiteSpace(_query))
        {
            var allowed = Lucene.FilterKeysByQuery(vectorHits.Select(h => h.key), _query);
            vectorHits = vectorHits.Where(h => allowed.Contains(h.key)).ToList();
        }

        var rrf = new Dictionary<string, (float score, float bm25, float vec)>(StringComparer.Ordinal);
        for (int rank = 0; rank < textHits.Count; rank++)
        {
            var (key, bm25, _) = textHits[rank];
            if (key == "") continue;
            rrf[key] = (1f / (k + rank + 1), bm25, 0);
        }
        for (int rank = 0; rank < vectorHits.Count; rank++)
        {
            var (key, cos) = vectorHits[rank];
            float c = 1f / (k + rank + 1);
            rrf[key] = rrf.TryGetValue(key, out var e) ? (e.score + c, e.bm25, cos) : (c, 0, cos);
        }

        var ranked = rrf.OrderByDescending(kv => kv.Value.score).Take(20).ToList();
        var docs   = Lucene.FetchByKeys(ranked.Select(kv => (kv.Key, kv.Value.vec)));
        foreach (var doc in docs)
        {
            var key = $"{doc.FilePath}:{doc.StartLine}";
            if (rrf.TryGetValue(key, out var s))
            { doc.BM25Score = s.bm25; doc.VectorScore = s.vec; doc.HybridScore = s.score; }
        }
        return docs.OrderByDescending(d => d.HybridScore).ToList();
    }

    private static bool MatchesPattern(string path, string pattern)
    {
        path    = path.Replace('\\', '/').ToLowerInvariant();
        pattern = pattern.ToLowerInvariant();
        if (pattern.Contains('*'))
        {
            var parts = pattern.Split('*', StringSplitOptions.RemoveEmptyEntries);
            int pos = 0;
            foreach (var part in parts)
            {
                int idx = path.IndexOf(part, pos, StringComparison.Ordinal);
                if (idx < 0) return false;
                pos = idx + part.Length;
            }
            return true;
        }
        return path.Contains(pattern) || path.Split('/').Any(seg => seg == pattern);
    }

    private static string TrimContent(string content)
    {
        var lines = content.Split('\n');
        return lines.Length > 20 ? string.Join('\n', lines.Take(20)) + "\n..." : content;
    }

    private static string FormatDate(string iso) =>
        DateTime.TryParse(iso, out var d) ? d.ToString("yyyy-MM-dd") : iso;

    private static string FormatBytes(string raw)
    {
        if (!long.TryParse(raw, out var b)) return raw;
        if (b < 1024) return $"{b} B";
        if (b < 1024 * 1024) return $"{b / 1024} KB";
        return $"{b / 1024 / 1024} MB";
    }

    private void ReindexFile(string filePath)
    {
        _ = Task.Run(() => Orchestrator.ReindexFileAsync(filePath));
    }

    private string ModeBtn(string m) => _mode == m ? "btn-primary" : "btn-outline-primary";

    private static string BadgeColor(string type) => type switch
    {
        "class"   => "bg-primary",
        "method"  => "bg-info text-dark",
        "file"    => "bg-secondary",
        "page"    => "bg-danger",
        "slide"   => "bg-warning text-dark",
        "sheet"   => "bg-success",
        "section" => "bg-secondary",
        "image"   => "bg-secondary",
        "block"   => "bg-dark",
        _         => "bg-dark"
    };
}
